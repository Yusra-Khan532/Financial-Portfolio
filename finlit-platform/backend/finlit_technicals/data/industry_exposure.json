    "import_rm": "share of raw materials imported and priced in US dollars, not counted in crude_rm",
    "metal_rm": "share of raw materials priced off steel, aluminium or copper",
    "agri_rm": "share of raw materials priced off farm commodities (moves with WPI primary articles)",
    "energy_opex": "share of other expenses that is fuel, power and freight",
    "energy_beta": "% move in that energy cost for a 1% move in crude priced in rupees",
    "var_opex": "share of other expenses that moves with sales volume within a year",
    "export_rev": "share of revenue earned in foreign currency",
    "crude_rev": "share of revenue whose price follows crude oil (oil producers, refiners, petrochemicals)",
    "crude_rev_beta": "% move in that revenue for a 1% move in crude priced in rupees",
    "demand_beta": "% change in this business's volumes for a 1% change in volumes of the average company",
    "pass_through": "share of a rupee of cost increase recovered through higher prices within 12 months (calibrated per company where history allows)",
    "floating_debt": "share of borrowings whose rate resets within 12 months",
    "excluded": "true = Stress Lab v1 does not cover this business (banks, NBFCs, insurers)"
  },
