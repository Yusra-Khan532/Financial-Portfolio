# Internal router on the VPS. Cloudflare Tunnel sends api.finlitventures.com here over plain HTTP;
# TLS is terminated by Cloudflare, so nothing else is exposed to the internet.
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	# Research service (fast, precomputed stock reports)
	@research path /mcp /.well-known/mcp.json /api/admin/mcp-stats /api/stocks/search-index /api/markets/* /api/client-errors /api/macro /api/flows /api/admin/flows /api/admin/flows/* /api/search/* /api/logos/* /api/screener/* /api/results/* /api/health /api/auth/* /api/me /api/me/* /api/admin/users /api/admin/users/* /api/admin/plan-requests /api/admin/plan-requests/* /api/admin/audit /api/ipos /api/feed /api/admin/feed /api/admin/feed/* /api/admin/ipos /api/admin/ipos/* /api/admin/data-health /api/compare/* /api/forum/* /api/admin/forum/* /api/etf/* /api/mf/* /api/mf-compare /api/mf-compare/* /api/advanced/* /api/dcf/* /api/options/* /api/commodity-prices /api/prism/* /api/outlook/*
	handle @research {
		reverse_proxy research-api:8000
	}
	# The old admin-only fundamentals dashboard stays on the site backend
	@siteStocks path /api/stocks/admin/*
	handle @siteStocks {
		reverse_proxy site-api:8001
	}
	@stocks path_regexp stocks ^/api/stocks/[A-Za-z0-9&_.-]+(/.*)?$
	handle @stocks {
		reverse_proxy research-api:8000
	}
	# Everything else under /api: content, portfolio, contact, enquiries, chat, ticker, admin
	handle /api/* {
		reverse_proxy site-api:8001
	}
	handle {
		respond "Not found" 404
	}
}
