# FinLit on AWS: settings file. Copy it OUTSIDE the git folder and fill it in:
#   cp /opt/finlit/src/finlit-platform/deploy/aws/.env.aws.example /opt/finlit/.env.aws && chmod 600 /opt/finlit/.env.aws && nano /opt/finlit/.env.aws
# Rules: one NAME=value per line, no spaces around "=", no quotes needed. Do NOT use the characters  $  "  '  #  or spaces inside a value.
# Never commit or share the filled-in file. deploy.sh refuses to run while any value still says CHANGE_ME.
# Secrets: run   openssl rand -base64 32   once per line marked SECRET and paste the output
# (for the two database passwords use  openssl rand -hex 24  instead: they sit inside a URL, which base64's  /  +  =  would break).

# ---------------------------------------------------------------------------- where the site lives
# Leave DOMAIN empty to serve plain http on the server's address. Later: point a DNS A record at the Elastic IP, then set it, e.g. DOMAIN=finlitventures.com
DOMAIN=
# The address people type: http://YOUR.ELASTIC.IP now, or https://your-domain once DOMAIN is set. Used for links in emails and for cookies.
PUBLIC_SITE_URL=http://CHANGE_ME_SERVER_IP
# Host names the API answers to. "*" is fine behind Caddy; tighten it to "yourdomain.com,localhost,127.0.0.1" if you like.
ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------- built-in database and cache (passwords only; the URLs are built by docker-compose.aws.yml)
# DATABASE_URL (postgresql://finlit:<POSTGRES_PASSWORD>@db:5432/finlit) and REDIS_URL (redis://:<REDIS_PASSWORD>@redis:6379/0) are set automatically from these two.
# SECRET (hex): openssl rand -hex 24. The database password is fixed when the database is first created; changing it later needs the steps in the README.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# SECRET (hex): openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# How many nightly database backups to keep.
BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------- the app (names and values as in render.yaml)
# staging = same behaviour as the Render deployment (e-mail confirmation off, API docs hidden). "production" needs Resend e-mail and a real domain first.
ENVIRONMENT=staging
# 1 = new accounts are confirmed at sign-up (no mail service yet). Must be 0 in production.
AUTO_VERIFY_EMAIL=1
# live = real FinEdge market data.
FINEDGE_MODE=live
# REQUIRED. FinEdge market data key (the founder's own).
FINEDGE_API_KEY=CHANGE_ME_FINEDGE_API_KEY
# Optional second data source for gaps in the statements. Expires daily; the site works without it. Leave empty if you have none.
UPSTOX_ACCESS_TOKEN=
# Company MongoDB Atlas connection string (blog, portfolio, forms). Leave empty to run without it: Prism and market data still work, blog/forms say "not connected".
# Atlas must allow this server's Elastic IP under Network Access.
MONGO_URL=
DB_NAME=finlit
# REQUIRED. SECRET: openssl rand -base64 32  (encrypts stored authenticator secrets and sessions)
SECRET_KEY=CHANGE_ME_SECRET_KEY
# REQUIRED. SECRET: openssl rand -base64 32  (signs the blog/CMS admin token; 32+ characters)
CMS_JWT_SECRET=CHANGE_ME_CMS_JWT_SECRET
# Password of the demo accounts demo-basic@, demo-silver@, demo-gold@finlit-demo.com. SECRET: openssl rand -base64 32. Empty = no demo accounts are created.
DEMO_PASSWORD=
# REQUIRED. The real administrator. Sign in at /login; the first sign-in asks you to set up an authenticator app.
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
# REQUIRED. 10+ characters, not containing the e-mail name. After your first sign-in you may delete this line.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Only when an authenticator is lost: put the account's e-mail here, redeploy once, then DELETE the line.
RESET_MFA_EMAIL=
# 1 = administrators must use their authenticator app (keep 1 on this public server; the Render copy ran with 0 temporarily).
ADMIN_REQUIRE_MFA=1

# ---------------------------------------------------------------------------- background loading and limits
# 1 = after each start, load the company list, prices and reports in the background (resumable). 0 = off.
BOOT_LOAD_ENABLED=1
# 1 = also load ETFs and mutual funds, score-mf and fund portfolios (each load needs about 150-200 MB extra while it runs). 0 = off: those nightly jobs then never run. Set 1 on the AWS server.
FUND_LOADS_ENABLED=0
# 1 = a background loop calculates every company's FinLit Prism rating ahead of time (one at a time, gives way to members), so reports open with the rating already there.
PRISM_PRECOMPUTE_ENABLED=1
# Companies loaded in the background after each start.
INGEST_LIMIT=500
# Other listed companies scored each night.
SCORE_ALL_PER_RUN=1500
RATE_LIMIT_PER_MINUTE=1200
# auto = start the site backend when MONGO_URL or the Prism keys are present | never | always
SITE_API_START=auto
# Reports calculated at once. render.yaml uses 1 for its 512 MB container; this server's app has 1200 MB, so 2. PRISM_SLOTS must not exceed PREMIUM_GENERATION_SLOTS.
PREMIUM_GENERATION_SLOTS=2
PRISM_SLOTS=2
# Provider data kept in memory (15 minutes each). render.yaml: 32.
STOCK_FUNDAMENTALS_CACHE_ENTRIES=64

# ---------------------------------------------------------------------------- optional services (leave empty until you have them)
# Dhan market data (docs/DHAN-SETUP.md): DHAN_CLIENT_ID + DHAN_PIN + DHAN_TOTP_SECRET (renews its own token), or DHAN_CLIENT_ID + DHAN_ACCESS_TOKEN.
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
DHAN_ACCESS_TOKEN=
# FinLit AI chat
GEMINI_API_KEY=
# E-mail (contact and enquiry forms; required for ENVIRONMENT=production with MAIL_MODE=resend)
RESEND_API_KEY=
SENDER_EMAIL=
CONTACT_RECIPIENT_EMAIL=
