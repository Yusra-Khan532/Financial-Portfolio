# Front door for the whole site. SITE_ADDRESS comes from docker-compose.aws.yml:
#   a domain name  -> automatic HTTPS (certificate from Let's Encrypt, renewed by Caddy itself, plain http redirected to https)
#   ":80"          -> plain http on whatever address the server has (use this until you own a domain)
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# One address per page: www goes to the bare domain with a permanent redirect (search engines then count one site, not two copies).
	@www host www.finlitventures.com
	redir @www https://finlitventures.com{uri} permanent

	# Security headers. "?" = only when the app has not already set the same header.
	header {
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "SAMEORIGIN"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Browsers ignore this over plain http, so it only takes effect once a domain with https is used.
		?Strict-Transport-Security "max-age=2592000"
		-Server
	}

	# Cache-Control is decided by the app (backend/finlit/web.py), per file, and Caddy passes it through untouched:
	#   /assets/*  hashed names -> immutable for a year, but a MISSING asset is a 404 with no-store
	#   index.html, version.json, sw.js, theme-init.js -> no-cache (always revalidated)
	# Do NOT add a blanket header for /assets/* here: it would also stamp "immutable, 1 year" on the 404 of a file from an older release.
	@fresh path / /index.html /version.json /sw.js /theme-init.js
	header @fresh Cache-Control "no-cache"

	# Caddy puts the address it actually saw into X-Forwarded-For and discards whatever the visitor sent,
	# which is exactly what the app expects (CLIENT_IP_HEADER=x-forwarded-for).
	#
	# No error page during a deploy. A deploy replaces the app container (deploy.sh: "Starting everything"); until the new one listens, the name
	# "app" does not answer. lb_try_duration makes Caddy hold the visitor's request and try again every second for up to 90 s (the app's start:
	# migrations, then the web server), so the page simply loads a little slower instead of showing "HTTP ERROR 502".
	reverse_proxy app:8000 {
		lb_try_duration 90s
		lb_try_interval 1s
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	# Only if the app is still not back after that (a long migration, a failed start): a calm page that reloads itself, never the browser's raw
	# error. The API answers JSON, so the website's own "try again" handling shows instead of a broken page.
	handle_errors 502 503 504 {
		header Cache-Control "no-store"
		header Retry-After "15"
		@api path /api/*
		handle @api {
			header Content-Type "application/json"
			respond `{"status":"updating","detail":"FinLit is being updated. Please try again in a few seconds."}` 503
		}
		handle {
			header Content-Type "text/html; charset=utf-8"
			respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="10"><title>FinLit is updating</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui,sans-serif;background:#f3eee2;color:#14213d}@media (prefers-color-scheme:dark){body{background:#14171c;color:#f3eee2}}main{max-width:28rem;padding:24px;text-align:center}h1{font-size:1.4rem;margin:0 0 8px}p{opacity:.8;line-height:1.5}</style></head><body><main><h1>FinLit is updating</h1><p>A new version is being switched on. This page reloads by itself in a few seconds; nothing is wrong with your connection.</p></main></body></html>` 503
		}
	}
}

# Extra sites on this server (e.g. the team workspace). Empty folder = nothing changes.
import /etc/caddy/extra/*.caddy
