# /etc/cron.d/finlit on the VPS (times are IST; set CRON_TZ or the server TZ to Asia/Kolkata).
CRON_TZ=Asia/Kolkata
SHELL=/bin/sh
W="docker compose -f /opt/finlit/docker-compose.yml run --rm -T worker"

# Live prices into every summary, each minute during market hours (Mon–Fri 09:15–15:30).
* 9-15 * * 1-5   root $W refresh-quotes  >> /var/log/finlit-quotes.log 2>&1
# Every company: load the ones never loaded, refresh the rest, nightly after FinEdge's end-of-day update (resumable).
30 1 * * *       root $W ingest-all --hours 20 >> /var/log/finlit-ingest.log 2>&1
# Stock universe for search: weekly.
15 2 * * 0       root $W refresh-universe >> /var/log/finlit-ingest.log 2>&1
# Price alerts and watchlist targets: every 10 minutes in market hours.
*/10 9-15 * * 1-5 root $W check-alerts --kind live >> /var/log/finlit-alerts.log 2>&1
# Everything else (RSI, scores, ratios, results, filings, holdings changes): each weekday evening after the data is in.
30 19 * * 1-5    root $W check-alerts --kind daily >> /var/log/finlit-alerts.log 2>&1
# New matches for members' saved screens: once a day after the nightly load.
30 7 * * 1-5     root $W check-screens >> /var/log/finlit-alerts.log 2>&1
# Weekly week-ahead email: Sunday evening.
30 18 * * 0      root $W send-digest >> /var/log/finlit-alerts.log 2>&1

# The jobs below match deploy/scheduler.sh (the free single-container setup), same IST times.
# Every listed company's price and market cap: nightly after the close.
10 20 * * *      root $W refresh-listing >> /var/log/finlit-ingest.log 2>&1
# Companies that have just reported are rebuilt hourly, so their quarter shows within hours.
20 8-23 * * *    root $W refresh-results >> /var/log/finlit-ingest.log 2>&1
35 8-23 * * *    root $W refresh-results-light >> /var/log/finlit-ingest.log 2>&1
# IPO and results calendars: each morning, and every hour until midnight (board-meeting dates are added through the day).
45 6 * * *       root $W refresh-calendars >> /var/log/finlit-ingest.log 2>&1
5 8-23 * * *     root $W refresh-calendars >> /var/log/finlit-ingest.log 2>&1
# India macro data (MoSPI and RBI): nightly.
50 18 * * *      root $W refresh-macro >> /var/log/finlit-ingest.log 2>&1
# FII/DII institutional flows (NSDL, NSE archive files): nightly, and again later because NSDL posts the day's report in the evening.
10 19 * * *      root $W refresh-flows >> /var/log/finlit-ingest.log 2>&1
30 21 * * *      root $W refresh-flows >> /var/log/finlit-ingest.log 2>&1
# Company and fund-house logos from their own websites (robots.txt obeyed): nightly, a batch at a time.
25 5 * * *       root $W refresh-logos >> /var/log/finlit-ingest.log 2>&1
# NIFTY index membership: weekly.
45 2 * * *       root $W refresh-indices >> /var/log/finlit-ingest.log 2>&1
40 3 * * *       root flock -w 10800 /tmp/finlit-funds.lock $W backfill-mf >> /var/log/finlit-funds.log 2>&1
# Leader / In line / Laggard labels: weekly, Saturday, after Friday's close; the reliability backtest: quarterly (first Sunday of Jan, Apr, Jul, Oct).
20 4 * * *      root $W backfill-history >> /var/log/finlit-ingest.log 2>&1
# The short/long-term technical view of every stored Prism report, from the day's final candles: 18:30 on weekdays, a late retry at 21:15, and a catch-up each morning.
30 18 * * 1-5    root $W refresh-technicals >> /var/log/finlit-ingest.log 2>&1
15 21 * * 1-5    root $W refresh-technicals >> /var/log/finlit-ingest.log 2>&1
50 6 * * *       root $W refresh-technicals >> /var/log/finlit-ingest.log 2>&1
10 5 * * *      root $W precompute-prism >> /var/log/finlit-ingest.log 2>&1
50 3 * * 6       root $W refresh-leadership >> /var/log/finlit-ingest.log 2>&1
10 4 * 1,4,7,10 0 root [ $(date +\%d) -le 7 ] && $W backtest-leadership >> /var/log/finlit-ingest.log 2>&1
# Keep the database inside its storage budget.
5 1 * * *        root $W prune >> /var/log/finlit-ingest.log 2>&1
# A rotating sample of the market: what the provider sent against what the reports show.
10 3 * * *       root $W audit-coverage --sample 80 --record >> /var/log/finlit-ingest.log 2>&1
# ETFs and mutual funds take turns on one lock (flock -w waits for the other instead of running beside it).
40 20 * * 1-5    root flock -w 10800 /tmp/finlit-funds.lock $W refresh-etf >> /var/log/finlit-funds.log 2>&1
10 22 * * 1-5    root flock -w 10800 /tmp/finlit-funds.lock $W refresh-etf --resume >> /var/log/finlit-funds.log 2>&1
40 23 * * 1-5    root flock -w 10800 /tmp/finlit-funds.lock $W refresh-etf --resume >> /var/log/finlit-funds.log 2>&1
10 21 * * *      root flock -w 10800 /tmp/finlit-funds.lock $W refresh-mf >> /var/log/finlit-funds.log 2>&1
30 23 * * *      root flock -w 10800 /tmp/finlit-funds.lock $W refresh-mf >> /var/log/finlit-funds.log 2>&1
40 21 * * *      root flock -w 10800 /tmp/finlit-funds.lock $W refresh-facts >> /var/log/finlit-funds.log 2>&1
# AMFI's monthly category report (Mutual Fund Insights): a daily check; a new month appears around the 8th-10th.
25 18 * * *      root flock -w 10800 /tmp/finlit-funds.lock $W refresh-industry >> /var/log/finlit-funds.log 2>&1
