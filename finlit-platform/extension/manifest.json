{
  "manifest_version": 3,
  "name": "FinLit Ventures: select to understand",
  "short_name": "FinLit",
  "version": "1.4.0",
  "description": "Select a financial term or a listed company on any web page to see its FinLit glossary meaning or its FinLit score (FinLit IQ on Silver, FinLit Prism on Gold). Reads only the words you select.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FinLit Ventures",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://finlitventures.com/*",
    "https://www.finlitventures.com/*",
    "https://app.finlitventures.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://finlitventures.com/*",
        "https://www.finlitventures.com/*",
        "https://app.finlitventures.com/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "lookup-selection": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Look up the selected text on FinLit"
    }
  },
  "minimum_chrome_version": "102"
}
