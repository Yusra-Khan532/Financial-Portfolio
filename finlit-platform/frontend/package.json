    "test": "vitest run",
    "overlay-guard": "node e2e/overlay_guard.mjs",
    "layout-guard": "node e2e/layout_guard.mjs",
    "layout-guard:api": "GUARD_MODE=api node e2e/layout_guard.mjs",
    "reveal-guard": "node e2e/reveal_guard.mjs",
    "page-headers": "node e2e/page_headers.mjs",
    "feature-info-guard": "node e2e/feature_info_guard.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "5.104.3",
    "lightweight-charts": "5.0.9",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "three": "0.186.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
